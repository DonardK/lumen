{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "description": "Paste a magnet link or torrent URL and stream it in a desktop player.",
  "author": "Lumen",
  "main": "electron/main.js",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win --x64",
    "test": "node --test electron/*.test.js",
    "test:metadata": "node --test electron/metadata.test.js",
    "test:streams": "node --test electron/streamServer.test.js"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron-store": "8.2.0",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "fluent-ffmpeg": "2.1.3",
    "lucide-react": "1.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "3.4.0",
    "tw-animate-css": "1.4.0",
    "webtorrent": "1.9.6"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.5",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3",
    "vite": "8.3.1",
    "wait-on": "9.1.0"
  }
}
